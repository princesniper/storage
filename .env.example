# =====================================================================
# Media Storage — environment template. PLACEHOLDERS ONLY. No real secrets.
# Copy to .env for local dev. Production values go in Fly.io secrets —
# NEVER commit real secrets to git, Dockerfile, or fly.toml.
# =====================================================================

# ---------------------------------------------------------------------
# LOCAL DEVELOPMENT
# - Postgres must be reachable locally (Docker, system install, or
#   `fly proxy`), because the Prisma schema targets PostgreSQL.
#   Example: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growplants
# - APP_URL stays localhost; public media URLs STILL use MEDIA_PUBLIC_URL.
# - Local serving of the canonical host: Caddyfile.dev + `bun run proxy:dev`
#   (hosts entry 127.0.0.1 m.media-growplants.com + `caddy trust`, one-time).
# ---------------------------------------------------------------------
# APP_URL=http://localhost:3000
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growplants
# MEDIA_PUBLIC_URL=https://m.media-growplants.com
# NEXTAUTH_URL=http://localhost:3000
# AUTH_SECRET=PASTE_64_HEX_CHARS_GENERATED_WITH_openssl_rand_hex_32
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=PASTE_STRONG_PASSWORD_MIN_8_CHARS
# TELEGRAM_API_ID=PASTE_NUMERIC_API_ID_FROM_my_telegram_org
# TELEGRAM_API_HASH=PASTE_API_HASH_FROM_my_telegram_org
# TELEGRAM_SESSION_KEY=PASTE_64_HEX_CHARS_GENERATED_WITH_openssl_rand_hex_32

# ---------------------------------------------------------------------
# PRODUCTION (Fly.io) — canonical values + secret checklist
# fly.toml [env] already sets the three non-secret canonical URLs:
#   MEDIA_PUBLIC_URL=https://m.media-growplants.com
#   APP_URL=https://m.media-growplants.com
#   NEXTAUTH_URL=https://m.media-growplants.com
# Set each secret with (values shown are SHAPE hints, not values):
#   fly secrets set DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
#   fly secrets set AUTH_SECRET="$(openssl rand -hex 32)"
#   fly secrets set ADMIN_EMAIL="you@example.com"
#   fly secrets set ADMIN_PASSWORD="a-strong-password-min-8-chars"
#   fly secrets set TELEGRAM_API_ID="12345678"
#   fly secrets set TELEGRAM_API_HASH="paste-from-my.telegram.org"
#   fly secrets set TELEGRAM_SESSION_KEY="$(openssl rand -hex 32)"
# IMPORTANT: TELEGRAM_SESSION_KEY must equal the key that encrypted the
# stored session row — keep the SAME value across deploys, or the saved
# GramJS session becomes unreadable and you must reconnect in Settings.
# ---------------------------------------------------------------------

# === App ===
APP_URL=http://localhost:3000
# next-auth production URL detection (Secure cookies behind Fly's proxy).
# Local: http://localhost:3000 — Production: https://m.media-growplants.com
NEXTAUTH_URL=http://localhost:3000

# === Media URLs ===
# Canonical public origin for /images/NNNNNN.ext URLs.
# Trailing slash is stripped automatically. Never localhost, never the
# Fly .fly.dev hostname. Unset = built-in default https://m.media-growplants.com
# Public file URLs are always e.g. https://m.media-growplants.com/images/000001.jpg
# (6-digit zero-padded sequential numbers + extension matching the stored type).
MEDIA_PUBLIC_URL=https://m.media-growplants.com

# === Auth ===
# Generate with: openssl rand -hex 32 (min 32 chars, 64 hex recommended)
AUTH_SECRET=PASTE_64_HEX_CHARS_GENERATED_WITH_openssl_rand_hex_32

# Initial admin (seeded on first boot; password is bcrypt-hashed in DB)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=PASTE_STRONG_PASSWORD_MIN_8_CHARS

# === Telegram ===
# From https://my.telegram.org → API development tools
TELEGRAM_API_ID=PASTE_NUMERIC_API_ID_FROM_my_telegram_org
TELEGRAM_API_HASH=PASTE_API_HASH_FROM_my_telegram_org
# 32-byte (64 hex char) key for AES-256-GCM encryption of the GramJS StringSession at rest.
# Generate with: openssl rand -hex 32. KEEP STABLE across deploys (see header).
TELEGRAM_SESSION_KEY=PASTE_64_HEX_CHARS_GENERATED_WITH_openssl_rand_hex_32

# === Upload limits ===
# V2: MAX_FILE_SIZE_MB is canonical (images + default). Legacy MAX_IMAGE_SIZE_MB
# still works as a fallback alias when MAX_FILE_SIZE_MB is unset.
MAX_FILE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=1024
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/quicktime,audio/mpeg,audio/wav,audio/x-wav,audio/ogg,audio/oga,audio/mp4,audio/aac,audio/webm,audio/flac,audio/x-flac,audio/m4a,audio/x-m4a
# V2: max files per bulk-upload batch (frontend + docs; per-file endpoint unchanged)
MAX_BULK_UPLOAD_FILES=10

# === Cache ===
CACHE_TTL_SECONDS=604800
CACHE_MAX_ITEMS=500
# V2: optional Redis cache primary (e.g. redis://localhost:6379).
# Empty/unreachable = automatic fallback to in-memory LRU.
# V1 PRODUCTION: leave empty (single Fly machine, no Managed Redis).
REDIS_URL=

# === Rate limiting ===
RATE_LIMIT_PUBLIC_PER_MIN=600
RATE_LIMIT_LOGIN_PER_15MIN=5
RATE_LIMIT_UPLOAD_PER_MIN=30

# === Database ===
# Production (managed Postgres — set as a Fly SECRET, not here):
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
# Local dev (Postgres required — schema no longer supports SQLite):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growplants
