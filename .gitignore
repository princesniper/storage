# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database (local SQLite)
# NOTE: backup copies (dev.db.backup-*) hold production-adjacent data
# (incl. bcrypt hashes + encrypted Telegram session) — never commit them.
*.db
*.db-journal
prisma/dev.db.backup-*
*.backup-*
/db/
/.data/

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Sandbox-only files
.zscripts/dev.pid
.zscripts/dev.log

# Local agent/sandbox artifacts (never ship to GitHub)
/DATA
/prompt
/worklog.md
/tool-results/

# Generated screenshots (kept locally in /download/)
download/*.png
download/*.jpg
download/*.jpeg
download/*.webp